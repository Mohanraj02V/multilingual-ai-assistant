# ==============================================
# Multilingual AI Assistant — Environment Config
# ==============================================
# Copy this file to .env and fill in your values.

# ---------------- LLM Provider ----------------
# Options: ollama (default) | openai | gemini | groq
LLM_PROVIDER=ollama

# ---------------- Ollama Settings ----------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# ---------------- Retrieval Settings ----------------
# Max knowledge documents to send to LLM as context
MAX_CONTEXT_DOCUMENTS=5

# Minimum keyword relevance score to include a document (0.0 – 1.0)
RETRIEVAL_MIN_SCORE=0.1

# ---------------- Input Limits ----------------
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_TURNS=10

# ---------------- CORS ----------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------- Knowledge Base ----------------
KNOWLEDGE_BASE_PATH=data/knowledge.json
